# ── Frontend (Vite) ─────────────────────────────────────────────────────────
# The app runs fully on mocks when these are blank. Fill them to go live.

# PostHog analytics (optional)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Supabase — enables real auth + entitlements
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: a static Polar checkout link (Products → share link). Set just this
# to redirect to the real Polar hosted checkout UI without a backend.
VITE_POLAR_CHECKOUT_LINK=

# ── Edge Function secrets (set with `supabase secrets set`, NOT in the client) ─
# Note: SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected
# into deployed functions automatically — do NOT set them yourself.
# APP_URL=                      # e.g. https://sysviz.app (for checkout redirects)
# POLAR_ACCESS_TOKEN=           # Polar organization access token
# POLAR_SERVER=sandbox          # sandbox | production
# POLAR_WEBHOOK_SECRET=         # from Polar → Webhooks
# POLAR_PRODUCT_1M=             # Polar product id for the 1-month plan
# POLAR_PRODUCT_6M=
# POLAR_PRODUCT_12M=
